#!/usr/bin/env python3
"""Installed entry point for the Qishi Note Vault backend."""

import os
import sys

APP_ROOT = os.environ.get("APP_ROOT", "/usr/local/qishi-note-vault")
sys.path.insert(0, os.path.join(APP_ROOT, "lib"))

from qishi_note_vault.server import main  # noqa: E402

raise SystemExit(main())
