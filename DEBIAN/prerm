#!/bin/bash
set -e

APP_USER="qishi-note-vault"
SYSTEM_ID="qishinotevault-system"

# App Center can invoke the lifecycle script with different Debian arguments.
# Always request a service stop so "disable/stop" cannot leave the daemon running.
if [ -d /run/systemd/system ]; then
    systemctl stop "${SYSTEM_ID}.service" 2>/dev/null || true
    systemctl disable "${SYSTEM_ID}.service" 2>/dev/null || true
fi

# Clean up any process that remained after systemd timed out.
pkill -u "${APP_USER}" 2>/dev/null || true
sleep 1

exit 0
