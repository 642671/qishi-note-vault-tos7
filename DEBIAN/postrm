#!/bin/sh
set -e

APP_ID="qishi-note-vault"
APP_USER="qishi-note-vault"
SYSTEM_ID="qishinotevault-system"
UNIT_DST="/etc/systemd/system/${SYSTEM_ID}.service"

rm -f "${UNIT_DST}"
# /var/api is a 1777 sticky directory on TOS 7. A socket left there by a crashed
# run can be owned by another uid, and unlinking it as a non-owner fails with
# EPERM. "rm -f" only hides missing files, not permission errors, so an unguarded
# call would abort purge under set -e and strand the unit file behind it.
rm -f "/var/api/${APP_ID}.sock" 2>/dev/null || true

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
fi

if [ "$1" = "purge" ]; then
    if id "${APP_USER}" >/dev/null 2>&1; then
        userdel "${APP_USER}" 2>/dev/null || true
    fi
    rm -rf "/usr/local/${APP_ID}/data" "/usr/local/${APP_ID}/logs"
fi

exit 0
